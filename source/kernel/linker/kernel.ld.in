OUTPUT_FORMAT(elf64-x86-64)
OUTPUT_ARCH(i386:x86-64)
ENTRY(osKernelEntry)

OS_KERNEL_LINK_ADDRESS = @OS_KERNEL_LINK_ADDRESS@;
OS_KERNEL_PAGE_SIZE_BYTES = @OS_KERNEL_PAGE_SIZE_BYTES@;

PHDRS
{
    text PT_LOAD FLAGS(@OS_KERNEL_SEGMENT_FLAGS_READ_EXECUTE@);
    rodata PT_LOAD FLAGS(@OS_KERNEL_SEGMENT_FLAGS_READ_ONLY@);
    data PT_LOAD FLAGS(@OS_KERNEL_SEGMENT_FLAGS_READ_WRITE@);
}

SECTIONS
{
    . = OS_KERNEL_LINK_ADDRESS;
    osKernelImageStart = .;

    .text ALIGN(OS_KERNEL_PAGE_SIZE_BYTES) :
    {
        osKernelTextStart = .;
        KEEP(*(.text.os_kernel_entry))
        *(.text .text.*)
        osKernelTextEnd = .;
    } :text

    .rodata ALIGN(OS_KERNEL_PAGE_SIZE_BYTES) :
    {
        osKernelReadOnlyDataStart = .;
        *(.rodata .rodata.*)
        osKernelReadOnlyDataEnd = .;
    } :rodata

    .data ALIGN(OS_KERNEL_PAGE_SIZE_BYTES) :
    {
        osKernelWritableDataStart = .;
        *(.data .data.*)
    } :data

    .bss ALIGN(OS_KERNEL_PAGE_SIZE_BYTES) (NOLOAD) :
    {
        *(.bss .bss.*)
        *(COMMON)
        osKernelWritableDataEnd = .;
    } :data

    osKernelImageEnd = .;

    /DISCARD/ :
    {
        *(.comment)
        *(.eh_frame)
        *(.note .note.*)
    }
}

ASSERT(DEFINED(osKernelEntry), "缺少内核入口 osKernelEntry")
